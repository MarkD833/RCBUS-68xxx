0070496F                           609  *******************************************************************************
0070496F                           610  *
0070496F                           611  *   #####  ####### #       ######         #####  #######    #    ######  ####### 
0070496F                           612  *  #     # #     # #       #     #       #     #    #      # #   #     #    #    
0070496F                           613  *  #       #     # #       #     #       #          #     #   #  #     #    #    
0070496F                           614  *  #       #     # #       #     #        #####     #    #     # ######     #    
0070496F                           615  *  #       #     # #       #     #             #    #    ####### #   #      #    
0070496F                           616  *  #     # #     # #       #     #       #     #    #    #     # #    #     #    
0070496F                           617  *   #####  ####### ####### ######         #####     #    #     # #     #    #    
0070496F                           618  *                                                                               
0070496F                           619  *******************************************************************************
0070496F                           620  * Monitor execution starts here after power-on or a reset.
0070496F                           621  *******************************************************************************
0070496F                           622  
00704970                           623      ORG     (*+1)&-2    * make sure we start on a word aligned address
00704970                           624  START:
00704970  4FF9 000FF800            625      lea     STACK_START, sp     * Set the stack pointer just in case
00704976  4DF9 000FF800            626      lea     STACK_START, a6     * A6 points to start of the monitor private variables area
0070497C                           627      
0070497C                           628      * copy the exception vector table into RAM
0070497C  207C 00700000            629      move.l  #ROM_BASE,a0        * start of exception table in ROM
00704982  227C 00000000            630      move.l  #VEC_BASE,a1        * location in RAM to copy table to
00704988  203C 000000FF            631      move.l  #255,d0             * 256 entries to copy
0070498E                           632  .copy:
0070498E  22D8                     633      move.l  (a0)+,(a1)+         * copy the longword address from ROM to RAM
00704990  51C8 FFFC                634      dbra    d0,.copy
00704994                           635  
00704994  6100 0406                636      bsr.w   serInit             * initialise serial port
00704998  46FC 2000                637      move.w  #$2000,sr           * enable interrupts
0070499C                           638  
0070499C                           639  *------------------------------------------------------------------------------
0070499C                           640  * Warm Restart entry point
0070499C                           641  *------------------------------------------------------------------------------
0070499C                           642  monStart:
0070499C  41FA 0666                643      lea     strBanner1(PC), a0  * Show the monitor details
007049A0  6100 0656                644      bsr.w   putString
007049A4                           645  
007049A4  41FA 06BC                646      lea     strCommands(PC), a0 * And the command help message
007049A8  6100 064E                647      bsr.w   putString
007049AC                           648  
007049AC                           649  monLoop:
007049AC  41FA 0859                650      lea     strPrompt(PC), a0   * Prompt
007049B0  6100 0646                651      bsr.w   putString
007049B4                           652  
007049B4                           653  monLoop_NP:
007049B4  6100 04B0                654      bsr.w   getc                * get a character into D0
007049B8  6100 0346                655      bsr.w   chToUpper           * convert character to upper case
007049BC                           656      
007049BC  0C00 000A                657      cmpi.b  #LF,d0              * ignore Line-Feed
007049C0  67EA                     658      beq.s   monLoop
007049C2                           659      
007049C2  B03C 0042                660      cmp.b   #'B', d0            * Boot EhBASIC v3.54
007049C6  6700 005E                661      beq.w   cmdBootEHBASIC
007049CA                           662  
007049CA  B03C 0043                663      cmp.b   #'C', d0            * Boot CP/M-68K
007049CE  6700 007E                664      beq.w   cmdBootCPM
007049D2                           665  
007049D2  B03C 0044                666      cmp.b   #'D', d0            * Dump memory command
007049D6  6700 00B2                667      beq.w   cmdDispMemory
007049DA                           668  
007049DA  B03C 0049                669      cmp.b   #'I', d0            * Read from I/O space address
007049DE  6700 00F4                670      beq.w   cmdIORead
007049E2                           671  
007049E2  B03C 004D                672      cmp.b   #'M', d0            * Modify memory command
007049E6  6700 012E                673      beq.w   cmdModifyMemory
007049EA                           674  
007049EA  B03C 004F                675      cmp.b   #'O', d0            * Write to I/O space address
007049EE  6700 0184                676      beq.w   cmdIOWrite
007049F2                           677  
007049F2  B03C 0053                678      cmp.b   #'S', d0            * S record download
007049F6  6700 01C6                679      beq.w   cmdDownload
007049FA                           680  
007049FA  B03C 0047                681      cmp.b   #'G', d0            * Go command
007049FE  6700 00AC                682      beq.w   cmdRun
00704A02                           683  
00704A02  B03C 003F                684      cmp.b   #'?', d0            * Help command
00704A06  6700 028A                685      beq.w   cmdHelp
00704A0A                           686  
00704A0A  B03C 0020                687      cmp.b   #' ', d0            * Ignore spaces
00704A0E  6FA4                     688      ble.s   monLoop_NP          * go back without printing prompt    
00704A10                           689  
00704A10  1200                     690      move.b  d0,d1               * save the unknown char
00704A12  41FA 07F6                691      lea     strUnkCmd(PC), a0   * unknown command
00704A16  6100 05E0                692      bsr.w   putString
00704A1A  1001                     693      move.b  d1,d0               * get unnknown char back
00704A1C  6100 05B4                694      bsr.w   writeByte           * print it
00704A20                           695      
00704A20                           696  monLoop_CRLF:
00704A20  6100 05D2                697      bsr.w   putCRLF
00704A24  6086                     698      bra.s   monLoop
00704A26                           699      
00704A26                           700  *------------------------------------------------------------------------------
00704A26                           701  * (B) Boot EhBASIC v3.54
00704A26                           702  *------------------------------------------------------------------------------
00704A26                           703  cmdBootEHBASIC:
00704A26                           704      * Perform a simple check to see if EhBASIC has been programmed into the
00704A26                           705      * EEPROM by reading the first address of EhBASIC in the EEPROM. If it
00704A26                           706      * contains 0xFFFF, then EhBASIC hasn't been programmed in!
00704A26  0C79 FFFF 00700400       707      cmpi.w  #$FFFF,EHBASIC_BASE
00704A2E  660C                     708      bne.s   .bootEHBASIC
00704A30  41FA 0904                709      lea     strBASICErr1(PC), a0
00704A34  6100 05C2                710      bsr.w   putString
00704A38  6000 FF72                711      bra.w   monLoop
00704A3C                           712  
00704A3C                           713  .bootEHBASIC:
00704A3C  207C 00700400            714      move.l  #EHBASIC_BASE,a0
00704A42  4E90                     715      jsr     (a0)                * jump to EhBASIC 
00704A44                           716  
00704A44                           717      * I don't think EhBASIC can return back to the monitor but just in case it can
00704A44                           718      * print out a message and wait for a reset.
00704A44  41FA 0923                719      lea     strBASICReturn(PC), a0
00704A48  6100 05AE                720      bsr.w   putString
00704A4C                           721  .forever:
00704A4C  60FE                     722      bra.s   .forever
00704A4E                           723  
00704A4E                           724  *------------------------------------------------------------------------------
00704A4E                           725  * (C) Boot CP/M-68K v1.3
00704A4E                           726  *------------------------------------------------------------------------------
00704A4E                           727  cmdBootCPM:
00704A4E                           728      * perform a simple check to see if CP/M has been programmed into the EEPROM
00704A4E                           729      * by reading address 0x0400 in the EEPROM. If it contains 0xFFFF then CP/M
00704A4E                           730      * hasn't been programmed in!
00704A4E  0C79 FFFF 00700400       731      cmpi.w  #$FFFF,CPM_BASE
00704A56  660C                     732      bne.s   .chkBIOS
00704A58  41FA 0833                733      lea     strCPMErr1(PC), a0
00704A5C  6100 059A                734      bsr.w   putString
00704A60  6000 FF4A                735      bra.w   monLoop
00704A64                           736      
00704A64                           737  .chkBIOS:   
00704A64                           738      * perform a simple check to see if the BIOS has been programmed into the EEPROM
00704A64                           739      * by reading address 0x0400 in the EEPROM. If it contains 0xFFFF then the CP/M
00704A64                           740      * BIOS hasn't been programmed in!
00704A64  0C78 FFFF 6000           741      cmpi.w  #$FFFF,$6000
00704A6A  660C                     742      bne.s   .bootCPM
00704A6C  41FA 0854                743      lea     strCPMErr2(PC), a0
00704A70  6100 0586                744      bsr.w   putString
00704A74  6000 FF36                745      bra.w   monLoop
00704A78                           746      
00704A78                           747  .bootCPM:
00704A78  207C 00700400            748      move.l  #CPM_BASE,a0
00704A7E  4E90                     749      jsr     (a0)            * jump to CP/M-68K 
00704A80                           750      
00704A80                           751      * I don't think CP/M-68K can return back to the moitor but just in case it can
00704A80                           752      * print out a message and wait for a reset.
00704A80  41FA 087A                753      lea     strCPMReturn(PC), a0
00704A84  6100 0572                754      bsr.w   putString
00704A88                           755  .forever:
00704A88  60FE                     756      bra.s   .forever
00704A8A                           757      
00704A8A                           758  *------------------------------------------------------------------------------
00704A8A                           759  * (D)ump memory
00704A8A                           760  * Display 256 bytes of memory as ASCII-HEX characters
00704A8A                           761  *------------------------------------------------------------------------------
00704A8A                           762  cmdDispMemory:
00704A8A  6100 03C8                763      bsr.w   putc                * echo back the command character in D0
00704A8E  103C 0020                764      move.b  #' ',d0
00704A92  6100 03C0                765      bsr.w   putc
00704A96                           766      
00704A96  4282                     767      clr.l   d2                  * pre-set D2 to 0
00704A98  7208                     768      move.l  #8,d1               * read up to 8 digits
00704A9A  6100 02C2                769      bsr.w   hexToIntEcho        * from the serial port into D0
00704A9E  6500 FF0C                770      bcs.w   monLoop             * back to prompt if there's an error
00704AA2                           771      
00704AA2  2040                     772      move.l  d0,a0               * A0 holds the start address
00704AA4  6100 01F8                773      bsr.w   dumpRAM
00704AA8                           774  
00704AA8  6000 FF02                775      bra.w   monLoop
