00704F06                          1379  easyTaskUnsupported:
00704F06  C141                    1380      exg     d0,d1               * put the task number into D1
00704F08  41FA 034B               1381      lea     strEasyTask1(PC), a0
00704F0C  6100 00EA               1382      bsr.w   putString
00704F10  C141                    1383      exg     d0,d1               * put the task number back into D0
00704F12  80FC 000A               1384      divu    #10,d0              * divide task number by 10
00704F16  6100 00C2               1385      bsr.w   writeNibble         * output the 10's digit
00704F1A  4840                    1386      swap    d0
00704F1C  6100 00BC               1387      bsr.w   writeNibble         * output the 1's digit
00704F20  41FA 0354               1388      lea     strEasyTask2(PC), a0
00704F24  6100 00D2               1389      bsr.w   putString
00704F28                          1390  .infloop:
00704F28  60FE                    1391      bra.s   .infloop
00704F2A                          1392  
00704F2A                          1393  *------------------------------------------------------------------------------
00704F2A                          1394  * EASy68K TRAP #15 - Task 0
00704F2A                          1395  * Display n characters of string at (A1), n is D1.W (stops on NULL or max 255) with CR, LF.
00704F2A                          1396  *------------------------------------------------------------------------------
00704F2A                          1397  easyTask0:
00704F2A  0241 00FF               1398      andi.w  #$00FF,d1           * DBRA works on a WORD so make sure upper byte is zero
00704F2E  5301                    1399      sub.b   #1,d1               * DBRA requires 1 less than actual number
00704F30                          1400  .loop:
00704F30  1019                    1401      move.b  (a1)+, d0           * Read in character
00704F32  6708                    1402      beq.s   .end                * Check for the null
00704F34                          1403      
00704F34  6100 FF1E               1404      bsr.w   putc                * Otherwise write the character
00704F38  51C9 FFF6               1405      dbra    d1,.loop            * And continue
00704F3C                          1406  .end:
00704F3C  6100 00B6               1407      bsr.w   putCRLF             * append CR & LF
00704F40  4E75                    1408      rts
00704F42                          1409  
00704F42                          1410  *------------------------------------------------------------------------------
00704F42                          1411  * EASy68K TRAP #15 - Task 1
00704F42                          1412  * Display n characters of string at (A1), n is D1.W (stops on NULL or max 255) without CR, LF.
00704F42                          1413  *------------------------------------------------------------------------------
00704F42                          1414  easyTask1:
00704F42  0241 00FF               1415      andi.w  #$00FF,d1           * DBRA works on a WORD so make sure upper byte is zero
00704F46  5301                    1416      sub.b   #1,d1               * DBRA requires 1 less than actual number
00704F48                          1417  .loop:
00704F48  1019                    1418      move.b  (a1)+, d0           * Read in character
00704F4A  6708                    1419      beq.s   .end                * Check for the null
00704F4C                          1420      
00704F4C  6100 FF06               1421      bsr.w   putc                * Otherwise write the character
00704F50  51C9 FFF6               1422      dbra    d1,.loop            * And continue
00704F54                          1423  .end:
00704F54  4E75                    1424      rts
00704F56                          1425  
00704F56                          1426  *------------------------------------------------------------------------------
00704F56                          1427  * EASy68K TRAP #15 - Task 5
00704F56                          1428  * Read single ASCII character from the keyboard into D1.B. 
00704F56                          1429  *------------------------------------------------------------------------------
00704F56                          1430  easyTask5:
00704F56  6100 FF0E               1431      bsr.w   getc                * wait for char - returned in D0
00704F5A  1200                    1432      move.b  d0,d1               * move the char into D1
00704F5C  4E75                    1433      rts
00704F5E                          1434      
00704F5E                          1435  *------------------------------------------------------------------------------
00704F5E                          1436  * EASy68K TRAP #15 - Task 6
00704F5E                          1437  * Display single ASCII character in D1.B.   
00704F5E                          1438  *------------------------------------------------------------------------------
00704F5E                          1439  easyTask6:
00704F5E  1001                    1440      move.b  d1,d0               * move the char into D0
00704F60  6100 FEF2               1441      bsr.w   putc                * output the char
00704F64  4E75                    1442      rts
00704F66                          1443  
00704F66                          1444  *------------------------------------------------------------------------------
00704F66                          1445  * EASy68K TRAP #15 - Task 7
00704F66                          1446  * Check for keyboard input. Set D1.B to 1 if keyboard input is pending,
00704F66                          1447  * otherwise set to 0.
00704F66                          1448  *------------------------------------------------------------------------------
00704F66                          1449  easyTask7:
00704F66  123C 0000               1450      move.b  #0,d1               * assume no char available
00704F6A  0C6E 0000 0004          1451      cmpi.w  #0,ser0RxSize(a6)   * check number of chars in rx queue
00704F70  6704                    1452      beq.s   .end
00704F72  123C 0001               1453      move.b  #1,d1               * there is at least 1 char available
00704F76                          1454  .end
00704F76  4E75                    1455      rts
00704F78                          1456  
00704F78                          1457  *------------------------------------------------------------------------------
00704F78                          1458  * EASy68K TRAP #15 - Task 13
00704F78                          1459  * Display the NULL terminated string at (A1) with CR, LF.
00704F78                          1460  *------------------------------------------------------------------------------
00704F78                          1461  easyTask13:
00704F78                          1462  .loop:
00704F78  1019                    1463      move.b  (a1)+, d0           * Read in character
00704F7A  6706                    1464      beq.s   .end                * Check for the null
00704F7C                          1465      
00704F7C  6100 FED6               1466      bsr.w   putc                * Otherwise write the character
00704F80  60F6                    1467      bra.s   .loop               * And continue
00704F82                          1468  .end:
00704F82  6100 0070               1469      bsr.w   putCRLF             * append CR & LF
00704F86  4E75                    1470      rts
00704F88                          1471  
00704F88                          1472  *------------------------------------------------------------------------------
00704F88                          1473  * EASy68K TRAP #15 - Task 14
00704F88                          1474  * Display the NULL terminated string pointed to by (A1).
00704F88                          1475  *------------------------------------------------------------------------------
00704F88                          1476  easyTask14:
00704F88                          1477  .loop:
00704F88  1019                    1478      move.b  (a1)+, d0           * Read in character
00704F8A  6706                    1479      beq.s   .end                * Check for the null
00704F8C                          1480      
00704F8C  6100 FEC6               1481      bsr.w   putc                * Otherwise write the character
00704F90  60F6                    1482      bra.s   .loop               * And continue
00704F92                          1483  .end:
00704F92  4E75                    1484      rts
00704F94                          1485  
00704F94                          1486  *------------------------------------------------------------------------------
00704F94                          1487  * This is the entry point for the TRAP #15 handler that gets called when any
00704F94                          1488  * TRAP #15 services are required. Only a few tasks are implemented.
00704F94                          1489  * Unimplemented tasks will produce an error message.
00704F94                          1490  *------------------------------------------------------------------------------
00704F94                          1491  easy68kTrap15:
00704F94  48E7 10A0               1492      movem.l d3/a0/a2,-(sp)
00704F98  45FA FF04               1493      lea     easy68kTaskTable(PC),a2
00704F9C  B03C 0019               1494      cmp.b   #25,d0              * is task number greater than 25?
00704FA0  6E00 FF64               1495      bgt     easyTaskUnsupported
00704FA4                          1496      
00704FA4  4283                    1497      clr.l   d3
00704FA6  1600                    1498      move.b  d0,d3               * task number into D3
00704FA8  E58B                    1499      lsl.l   #2,d3               * convert task number into longword offset
00704FAA  4EB2 3000               1500      jsr     (a2,d3)             * jump to the specific task handler
00704FAE                          1501      
00704FAE  4CDF 0508               1502      movem.l (sp)+,d3/a0/a2
00704FB2  4E73                    1503      rte
00704FB4                          1504  
00704FB4                          1505  *******************************************************************************
00704FB4                          1506  *
00704FB4                          1507  *  ######  ######  ### #     # #######    ######  ####### #     # ####### ### #     # #######  #####  
00704FB4                          1508  *  #     # #     #  #  ##    #    #       #     # #     # #     #    #     #  ##    # #       #     # 
00704FB4                          1509  *  #     # #     #  #  # #   #    #       #     # #     # #     #    #     #  # #   # #       #       
00704FB4                          1510  *  ######  ######   #  #  #  #    #       ######  #     # #     #    #     #  #  #  # #####    #####  
00704FB4                          1511  *  #       #   #    #  #   # #    #       #   #   #     # #     #    #     #  #   # # #             # 
00704FB4                          1512  *  #       #    #   #  #    ##    #       #    #  #     # #     #    #     #  #    ## #       #     # 
00704FB4                          1513  *  #       #     # ### #     #    #       #     # #######  #####     #    ### #     # #######  #####    
00704FB4                          1514  *
00704FB4                          1515  *******************************************************************************
00704FB4                          1516  * These are the various printing routines that handle displaying of bytes,
00704FB4                          1517  * words, long words and 24-bit values as ASCII hexadecimal text. The routines
00704FB4                          1518  * must be kept in this order as program flow is meant to fall out of one
00704FB4                          1519  * routine and into the next, often without a return statement.
00704FB4                          1520  *******************************************************************************
00704FB4                          1521  
00704FB4                          1522  *------------------------------------------------------------------------------
00704FB4                          1523  * Output a 32-bit address as 8 ASCII hexadecimal digits
00704FB4                          1524  * D0 holds the 32-bit address
00704FB4                          1525  *------------------------------------------------------------------------------
00704FB4                          1526  writeAddr32:
00704FB4  2F00                    1527      move.l  d0,-(sp)            * save D0 first
00704FB6  E098                    1528      ror.l   #8,d0
00704FB8  E098                    1529      ror.l   #8,d0
00704FBA  610E                    1530      bsr.s   writeWord           * write bits 16..31
00704FBC  201F                    1531      move.l  (sp)+,d0            * restore D0
00704FBE  600A                    1532      bra.s   writeWord
00704FC0                          1533      
00704FC0                          1534  *------------------------------------------------------------------------------
00704FC0                          1535  * Output a 24-bit address as 6 ASCII hexadecimal digits
00704FC0                          1536  * D0 holds the address in bits 0..23
00704FC0                          1537  * NOTE: the writeWord function must be directly after this function
00704FC0                          1538  *------------------------------------------------------------------------------
00704FC0                          1539  writeAddr24:
00704FC0  2F00                    1540      move.l  d0,-(sp)            * save D0 first
00704FC2  E098                    1541      ror.l   #8,d0
00704FC4  E098                    1542      ror.l   #8,d0
00704FC6  610A                    1543      bsr.s   writeByte           * write bits 16..23
00704FC8  201F                    1544      move.l  (sp)+,d0            * restore D0
00704FCA                          1545      
00704FCA                          1546  *------------------------------------------------------------------------------
00704FCA                          1547  * Output a word as 4 ASCII hexadecimal digits
00704FCA                          1548  * D0 holds the word in bits 0..15
00704FCA                          1549  * NOTE: the writeByte function must be directly after this function
00704FCA                          1550  *------------------------------------------------------------------------------
00704FCA                          1551  writeWord:
00704FCA  3F00                    1552      move.w  d0,-(sp)            * save D0 first
00704FCC  E058                    1553      ror.w   #8,d0               * get upper byte (0 => shift 8 times)
00704FCE  6102                    1554      bsr.s   writeByte
00704FD0  301F                    1555      move.w  (sp)+,d0            * restore D0
00704FD2                          1556  
00704FD2                          1557  *------------------------------------------------------------------------------
00704FD2                          1558  * Output a byte as 2 ASCII hexadecimal digits
00704FD2                          1559  * D0 holds the byte in bits 0..7
00704FD2                          1560  * NOTE: the writeNibble function must be directly after this function
00704FD2                          1561  *------------------------------------------------------------------------------
00704FD2                          1562  writeByte:
00704FD2  3F00                    1563      move.w  d0,-(sp)            * save D0 first
00704FD4  E818                    1564      ror.b   #4,d0               * get upper nibble
00704FD6  6102                    1565      bsr.s   writeNibble
00704FD8  301F                    1566      move.w  (sp)+,d0            * restore D0
00704FDA                          1567      
00704FDA                          1568  *------------------------------------------------------------------------------
00704FDA                          1569  * Output 4 bits as an ASCII hexadecimal digit
00704FDA                          1570  * D0 holds the nibble in bits 0..3
00704FDA                          1571  *------------------------------------------------------------------------------
00704FDA                          1572  writeNibble:
00704FDA  3F00                    1573      move.w  d0,-(sp)            * save D0 first
00704FDC  0200 000F               1574      andi.b  #$0F,d0             * make sure we only have the lower 4 bits
00704FE0  0C00 000A               1575      cmpi.b  #10,d0              * compare D0 to 10
00704FE4  6502                    1576      bcs.b   .wn1                * less than 10 so don't add 7
00704FE6  5E00                    1577      addi.b  #07,d0              * add 7
00704FE8                          1578  .wn1:
00704FE8  0600 0030               1579      addi.b  #'0',d0             * add ASCII code for char zero
00704FEC  6100 FE66               1580      bsr.w   putc                * write the ASCII digit out
00704FF0  301F                    1581      move.w  (sp)+,d0            * restore D0
00704FF2  4E75                    1582      rts
00704FF4                          1583  
00704FF4                          1584  *------------------------------------------------------------------------------
00704FF4                          1585  * Prints a newline (CR, LF)
00704FF4                          1586  * NOTE: the putString function must follow this function
00704FF4                          1587  *------------------------------------------------------------------------------
00704FF4                          1588  putCRLF:
00704FF4  41FA 0226               1589      lea     strNewline(PC), a0
00704FF8                          1590  
00704FF8                          1591  *------------------------------------------------------------------------------
00704FF8                          1592  * Print a null terminated string
00704FF8                          1593  * A0 holds the address of the first character of the null terminated string
00704FF8                          1594  *------------------------------------------------------------------------------
00704FF8                          1595  putString:
00704FF8                          1596  .loop:
00704FF8  1018                    1597      move.b  (a0)+, d0           * Read in character
00704FFA  6706                    1598      beq.s   .end                * Check for the null
00704FFC                          1599      
00704FFC  6100 FE56               1600      bsr.w   putc                * Otherwise write the character
00705000  60F6                    1601      bra.s   .loop               * And continue
00705002                          1602  .end:
00705002  4E75                    1603      rts
