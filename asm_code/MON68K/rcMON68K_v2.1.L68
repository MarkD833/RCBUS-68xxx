00704AAC                           777  *------------------------------------------------------------------------------
00704AAC                           778  * (G)o - execute code in memory starting at the specified address
00704AAC                           779  *------------------------------------------------------------------------------
00704AAC                           780  cmdRun:
00704AAC  6100 03A6                781      bsr.w   putc                * echo back the command character in D0
00704AB0  103C 0020                782      move.b  #' ',d0
00704AB4  6100 039E                783      bsr.w   putc
00704AB8                           784  
00704AB8  4282                     785      clr.l   d2                  * pre-set D2 to 0
00704ABA  7208                     786      move.l  #8,d1               * read up to 8 digits
00704ABC  6100 02A0                787      bsr.w   hexToIntEcho        * from the serial port
00704AC0  6500 FEEA                788      bcs.w   monLoop             * back to prompt if there's an error
00704AC4                           789  
00704AC4  2040                     790      move.l  d0, a0              * copy start address into A0
00704AC6  4E90                     791      jsr     (a0)                * jump to user code
00704AC8                           792      
00704AC8  41FA 076F                793      lea     strUserReturn(PC),a0
00704ACC  6100 052A                794      bsr.w   putString
00704AD0                           795      
00704AD0  6000 FEDA                796      bra.w   monLoop
