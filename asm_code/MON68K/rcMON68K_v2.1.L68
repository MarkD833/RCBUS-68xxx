00704B74                           866  *------------------------------------------------------------------------------
00704B74                           867  * (O)utput a byte to I/O space address
00704B74                           868  *------------------------------------------------------------------------------
00704B74                           869  cmdIOWrite:
00704B74  6100 02DE                870      bsr.w   putc                * echo back the command character in D0
00704B78  103C 0020                871      move.b  #' ',d0
00704B7C  6100 02D6                872      bsr.w   putc
00704B80                           873  
00704B80  4282                     874      clr.l   d2                  * pre-set D2 to 0
00704B82  7202                     875      move.l  #2,d1               * read up to 2 digit address
00704B84  6100 01D8                876      bsr.w   hexToIntEcho        * from the serial port
00704B88  6500 FE22                877      bcs.w   monLoop             * back to prompt if there's an error
00704B8C  1600                     878      move.b  d0,d3               * save the typed in 8-bit address
00704B8E  103C 003D                879      move.b  #'=',d0
00704B92  6100 02C0                880      bsr.w   putc                * send an EQUALS
00704B96                           881  
00704B96  4282                     882      clr.l   d2                  * pre-set D2 to 0
00704B98  7202                     883      move.l  #2,d1               * read up to 2 digit value
00704B9A  6100 01C2                884      bsr.w   hexToIntEcho        * from the serial port
00704B9E  6500 FE0C                885      bcs.w   monLoop             * back to prompt if there's an error
00704BA2                           886  
00704BA2                           887      ; D0 = value and D3 = 8-bit address
00704BA2  207C 00FA0000            888      movea.l #IO_BASE,a0
00704BA8  0283 000000FF            889      andi.l  #$FF,d3             * clear all the unused bits
00704BAE  E383                     890      asl.l   #1,d3               * make it a word offset
00704BB0  5283                     891      addi.l  #1,d3               * make it an odd address to write to D0..D7
00704BB2  1180 3000                892      move.b  d0,(0,a0,d3)        * and write the new value out
00704BB6                           893  
00704BB6  6100 043C                894      bsr.w   putCRLF
00704BBA  6000 FDF0                895      bra.w   monLoop
