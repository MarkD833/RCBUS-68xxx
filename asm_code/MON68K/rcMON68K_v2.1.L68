00704AD4                           798  *------------------------------------------------------------------------------
00704AD4                           799  * (I)nput a byte from I/O space address
00704AD4                           800  *------------------------------------------------------------------------------
00704AD4                           801  cmdIORead:
00704AD4  6100 037E                802      bsr.w   putc                * echo back the command character in D0
00704AD8  103C 0020                803      move.b  #' ',d0
00704ADC  6100 0376                804      bsr.w   putc
00704AE0                           805  
00704AE0  4282                     806      clr.l   d2                  * pre-set D2 to 0
00704AE2  7202                     807      move.l  #2,d1               * read up to 2 digit address
00704AE4  6100 0278                808      bsr.w   hexToIntEcho        * from the serial port
00704AE8  6500 FEC2                809      bcs.w   monLoop             * back to prompt if there's an error
00704AEC  1600                     810      move.b  d0,d3               * save the typed in 8-bit address
00704AEE  103C 003D                811      move.b  #'=',d0
00704AF2  6100 0360                812      bsr.w   putc                * send an EQUALS
00704AF6                           813  
00704AF6                           814      ; D3 = 8-bit address
00704AF6  207C 00FA0000            815      movea.l #IO_BASE,a0
00704AFC  0283 000000FF            816      andi.l  #$FF,d3             * clear all the unused bits
00704B02  E383                     817      asl.l   #1,d3               * make it a word offset
00704B04  5283                     818      addi.l  #1,d3               * make it an odd address to read from D0..D7
00704B06  1030 3000                819      move.b  (0,a0,d3),d0        * and read the new value in
00704B0A  6100 04C6                820      bsr.w   writeByte           * display the value
00704B0E  6100 04E4                821      bsr.w   putCRLF
00704B12  6000 FE98                822      bra.w   monLoop
