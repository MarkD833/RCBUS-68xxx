00000000                           166  *******************************************************************************
00000000                           167  * The serial port originally ran at 38400 baud for the MC68681 SIO chip.
00000000                           168  * Alternative compatibe chips were made by Philips (SCC68681,SCN68681 & SCC68692)
00000000                           169  * that supported higher baud rates using a special test mode.
00000000                           170  * Set HI_SPEED to 1 to enable 115200 baud or 0 for standard 38400 baud.  
00000000                           171  *******************************************************************************
00000000  =00000001                172  HI_SPEED    equ 1
00000000                           173  
00000000                           174  *------------------------------------------------------------------------------
00000000                           175  * ASCII control characters
00000000                           176  *------------------------------------------------------------------------------
00000000  =0000000A                177  LF    equ $0A
00000000  =0000000D                178  CR    equ $0D
00000000                           179  
00000000                           180  *------------------------------------------------------------------------------
00000000                           181  * Serial port receive buffer size - must be multiples of 2!
00000000                           182  * UPPER sets max chars in buffer before asking host PC to stop sending.
00000000                           183  * LOWER sets min chars in buffer before asking host PC to start sending again.
00000000                           184  *------------------------------------------------------------------------------
00000000  =00000100                185  SERIAL_BUFFER_SIZE  equ 256
00000000  =000000FF                186  SERIAL_BUFFER_MASK  equ SERIAL_BUFFER_SIZE-1
00000000  =000000C8                187  SERIAL_BUFFER_UPPER equ 200
00000000  =00000019                188  SERIAL_BUFFER_LOWER equ 25
00000000                           189  
