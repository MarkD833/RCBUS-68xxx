00704BBE                           897  *------------------------------------------------------------------------------
00704BBE                           898  * (S) - download a single line of a Motorola S-Record
00704BBE                           899  *------------------------------------------------------------------------------
00704BBE                           900  cmdDownload:
00704BBE  6100 02A6                901      bsr.w   getc                * get the S-Record type
00704BC2  B03C 0031                902      cmp.b   #'1', d0
00704BC6  671A                     903      beq.s   .cdl_S1             * read in an S1 record
00704BC8  B03C 0032                904      cmp.b   #'2', d0
00704BCC  6738                     905      beq.s   .cdl_S2             * read in an S2 record
00704BCE  B03C 0038                906      cmp.b   #'8', d0
00704BD2  6700 00A8                907      beq.w   .cdl_EOL89          * handle S8 SRec terminator
00704BD6  B03C 0039                908      cmp.b   #'9', d0
00704BDA  6700 00A0                909      beq.w   .cdl_EOL89          * handle S9 SRec terminator
00704BDE                           910  
00704BDE  6600 008A                911      bne     .cdl_EOL            * not S1 or S2 so ignore to end of line
00704BE2                           912              
00704BE2                           913  .cdl_S1:        
00704BE2  4282                     914      clr.l   d2
00704BE4  123C 0002                915      move.b  #2, d1              * 2 characters to read
00704BE8  6100 013A                916      bsr     hexToInt            * convert to byte count
00704BEC  2C00                     917      move.l  d0, d6              * D6 = byte count
00704BEE  2E00                     918      move.l  d0, d7              * D7 = byte count (running checksum)
00704BF0                           919  
00704BF0  4282                     920      clr.l   d2
00704BF2  123C 0004                921      move.b  #4, d1              * 4 characters to read
00704BF6  6100 012C                922      bsr     hexToInt            * convert to address
00704BFA  2640                     923      movea.l d0, a3              * A3 = destination address
00704BFC  DE00                     924      add.b   d0, d7              * update checksum with bits 00..07
00704BFE  E088                     925      lsr.l   #8, d0
00704C00  DE00                     926      add.b   d0, d7              * update checksum with bits 08..15
00704C02                           927  
00704C02  5746                     928      subq.w  #3, D6              * take off the 3 bytes we just read in
00704C04                           929  
00704C04  6026                     930      bra.s   .cdl_1              
00704C06                           931                  
00704C06                           932  .cdl_S2:            
00704C06  4282                     933      clr.l   d2
00704C08  123C 0002                934      move.b  #2, d1              * 2 characters to read
00704C0C  6100 0116                935      bsr     hexToInt            * convert to byte count
00704C10  2C00                     936      move.l  d0, d6              * D6 = byte count
00704C12  2E00                     937      move.l  d0, d7              * D7 = byte count (running checksum)
00704C14                           938  
00704C14  4282                     939      clr.l   d2
00704C16  123C 0006                940      move.b  #6, d1              * 6 characters to read
00704C1A  6100 0108                941      bsr     hexToInt            * convert to address
00704C1E  2640                     942      movea.l d0, a3              * A3 = destination address
00704C20  DE00                     943      add.b   d0, d7              * update checksum with bits 00..07
00704C22  E088                     944      lsr.l   #8, d0
00704C24  DE00                     945      add.b   d0, d7              * update checksum with bits 08..15
00704C26  E088                     946      lsr.l   #8, d0
00704C28  DE00                     947      add.b   d0, d7              * update checksum with bits 16..23
00704C2A                           948  
00704C2A  5946                     949      subq.w  #4, d6              * take off the 4 bytes we just read in
00704C2C                           950  
00704C2C                           951  .cdl_1:
00704C2C  4A46                     952      tst.w   d6                  * read all the bytes yet?
00704C2E  6712                     953      beq.s   .cdl_2
00704C30                           954  
00704C30  4282                     955      clr.l   d2
00704C32  323C 0002                956      move.w  #2, d1              * 2 characters to read
00704C36  6100 00EC                957      bsr     hexToInt            * convert to data byte
00704C3A  16C0                     958      move.b  d0, (a3)+           * write the byte to memory
00704C3C  DE00                     959      add.b   d0, d7              * update checksum
00704C3E  5346                     960      subq.w  #1, d6              * decrement byte count
00704C40  60EA                     961      bra.s   .cdl_1
00704C42                           962  
00704C42                           963  .cdl_2:
00704C42  4282                     964      clr.l   d2
00704C44  323C 0002                965      move.w  #2, d1              * 2 characters to read
00704C48  6100 00DA                966      bsr     hexToInt            * convert to checksum byte
00704C4C  DE00                     967      add.b   d0, d7              * D7 = calc checksum + srec checksum
00704C4E  5207                     968      addq.b  #1, d7              * checksum + 1 should = 0 if OK
00704C50  670C                     969      beq.s   .cdl_X
00704C52                           970  
00704C52  103C 0058                971      move.b  #'X', d0            * checksum fail - print an X
00704C56  6100 01FC                972      bsr     putc
00704C5A  6000 FD58                973      bra.w   monLoop_NP          * return to main loop without prompt
00704C5E                           974  
00704C5E                           975  .cdl_X
00704C5E  103C 002E                976      move.b  #'.', d0            * checksum good - print a dot
00704C62  6100 01F0                977      bsr     putc
00704C66  6000 FD4C                978      bra.w   monLoop_NP          * return to main loop without prompt
00704C6A                           979  
00704C6A                           980  .cdl_EOL
00704C6A  6100 01FA                981      bsr.w   getc                * discard chars until CR or LF
00704C6E  0C00 000D                982      cmpi.b  #CR,d0
00704C72  67EA                     983      beq.s   .cdl_X
00704C74  0C00 000A                984      cmpi.b  #LF,d0
00704C78  67E4                     985      beq.s   .cdl_X
00704C7A  60EE                     986      bra.s   .cdl_EOL
00704C7C                           987  
00704C7C                           988  .cdl_EOL89
00704C7C  6100 01E8                989      bsr.w   getc                * discard chars until CR or LF
00704C80  0C00 000D                990      cmpi.b  #CR,d0
00704C84  6700 FD9A                991      beq.w   monLoop_CRLF        * return to main loop with prompt
00704C88  0C00 000A                992      cmpi.b  #LF,d0
00704C8C  6700 FD92                993      beq.w   monLoop_CRLF        * return to main loop with prompt
00704C90  60EA                     994      bra.s   .cdl_EOL89
00704C92                           995      
00704C92                           996  *------------------------------------------------------------------------------
00704C92                           997  * Display the supported commands
00704C92                           998  *------------------------------------------------------------------------------
00704C92                           999  cmdHelp:
00704C92  41FA 03CE               1000      lea     strCommands(PC), a0
00704C96  6100 0360               1001      bsr.w   putString
00704C9A  6000 FD10               1002      bra.w   monLoop
00704C9E                          1003  
00704C9E                          1004  *------------------------------------------------------------------------------
00704C9E                          1005  * Dumps a 256 section of RAM to the screen
00704C9E                          1006  * Displays both hex values and ASCII characters
00704C9E                          1007  * a0 - Start Address
00704C9E                          1008  *------------------------------------------------------------------------------
00704C9E                          1009  dumpRAM:
00704C9E  48E7 E040               1010      movem.l d0-d2/a1, -(SP)     * Save registers
00704CA2  2248                    1011      move.l  a0,a1               * move the start address to A1
00704CA4                          1012  
00704CA4  6100 034E               1013      bsr.w   putCRLF             * new line - trashes D0 & A0
00704CA8                          1014      
00704CA8  323C 000F               1015      move.w  #15,d1              * 16 rows of data (DBRA needs 1 less!)
00704CAC                          1016  .dr_1:
00704CAC  343C 000F               1017      move.w  #15,d2              * 16 bytes of data per row (DBRA needs 1 less!)
00704CB0  2009                    1018      move.l  a1, d0              * copy the start address of the line into D0          
00704CB2  6100 0300               1019      bsr.w   writeAddr32         * Display as a 32-bit hex value
00704CB6  41FA 0567               1020      lea     strColonSpace(PC), a0
00704CBA  6100 033C               1021      bsr.w   putString
00704CBE  41EE 0106               1022      lea     msgASCIIDump(a6), a0
00704CC2                          1023  .dr_2:
00704CC2  1019                    1024      move.b  (a1)+, d0           * Read a byte from RAM
00704CC4  6100 030C               1025      bsr.w   writeByte           * display byte as 2 hex digits  
00704CC8  6100 0048               1026      bsr.w   makePrintable       * convert to printable character
00704CCC  10C0                    1027      move.b  d0,(a0)+            * save the printable char in output string
00704CCE  103C 0020               1028      move.b  #' ', d0
00704CD2  6100 0180               1029      bsr.w   putc                * insert a space
00704CD6  51CA FFEA               1030      dbra    d2,.dr_2
00704CDA                          1031  
00704CDA  103C 0020               1032      move.b  #' ', d0
00704CDE  6100 0174               1033      bsr.w   putc                * insert a space
00704CE2                          1034  
00704CE2  10FC 000D               1035      move.b  #CR,(a0)+
00704CE6  10FC 000A               1036      move.b  #LF,(a0)+
00704CEA  10FC 0000               1037      move.b  #0,(a0)+
00704CEE  41EE 0106               1038      lea     msgASCIIDump(a6), a0
00704CF2  6100 0304               1039      bsr.w   putString           * print out the printable bytes
00704CF6  51C9 FFB4               1040      dbra    d1,.dr_1
00704CFA                          1041  
00704CFA  4CDF 0207               1042      movem.l (SP)+, d0-d2/a1     * Restore registers
00704CFE  4E75                    1043      rts
00704D00                          1044              
00704D00                          1045  *------------------------------------------------------------------------------
00704D00                          1046  * Convert character in D0 to upper case
00704D00                          1047  * Only changes D0 if char is between 'a'..'z'
00704D00                          1048  *------------------------------------------------------------------------------
00704D00                          1049  chToUpper:
00704D00  B03C 0061               1050      cmp.b   #'a', d0         
00704D04  6D0A                    1051      blt.s   .done               * less than lower-case 'a' so leave alone
00704D06  B03C 007A               1052      cmp.b   #'z', d0
00704D0A  6E04                    1053      bgt.s   .done               * greater than lower-case 'z' so leave alone
00704D0C  0400 0020               1054      sub.b   #$20, d0            * convert to upper case
00704D10                          1055  .done:
00704D10  4E75                    1056      rts
00704D12                          1057      
00704D12                          1058  *------------------------------------------------------------------------------
00704D12                          1059  * Convert a byte into a print safe character
00704D12                          1060  * Substitute a '.' for any byte <32 or >126
00704D12                          1061  * D0 holds the byte
00704D12                          1062  *------------------------------------------------------------------------------
00704D12                          1063  makePrintable:
00704D12  B03C 0020               1064      cmp.b   #' ', d0         
00704D16  6D06                    1065      blt.s   .mp_1               * less than a SPACE (char 32)
00704D18                          1066  
00704D18  B03C 007E               1067      cmp.b   #'~', d0         
00704D1C  6F04                    1068      ble.s   .mp_x               * less than a DEL (char 127)
00704D1E                          1069  
00704D1E                          1070  .mp_1:
00704D1E  103C 002E               1071      move.b  #'.',d0             * substitute a DOT (char 46)
00704D22                          1072  .mp_x:
00704D22  4E75                    1073      rts
00704D24                          1074      
00704D24                          1075  *--------------------------------------------------------------------------
00704D24                          1076  * Read in an ASCII-HEX number - no echo back
00704D24                          1077  *
00704D24                          1078  * D2 = Value to return if no digits read in
00704D24                          1079  * D1 = Max no of ASCII digits to read in
00704D24                          1080  * D0 = Result
00704D24                          1081  * Carry flag set if an error occurs / not ASCII-HEX digit
00704D24                          1082  *--------------------------------------------------------------------------
00704D24                          1083  hexToInt:
00704D24                          1084  *   move.l  d2,-(SP)            * save D2
00704D24                          1085  *   clr.l   d2                  * D2 used to accumulate the final value
00704D24                          1086  .h2i_1:
00704D24  6100 0140               1087      bsr.w   getc                * get a character
00704D28  61D6                    1088      bsr.s   chToUpper           * convert to upper case if needed
00704D2A                          1089  
00704D2A  0C00 000A               1090      cmpi.b  #10,d0              * finish if it's CR or LF
00704D2E  6724                    1091      beq.s   .h2i_x
00704D30  0C00 000D               1092      cmpi.b  #13,d0
00704D34  671E                    1093      beq.s   .h2i_x
00704D36                          1094      
00704D36  0400 0030               1095      subi.b  #'0',d0
00704D3A  6B1C                    1096      bmi.s   .h2i_err            * quit if char is less than '0'
00704D3C                          1097  
00704D3C  0C00 0009               1098      cmpi.b  #9,d0
00704D40  6F0A                    1099      ble.s   .h2i_2              * is it <= 9
00704D42                          1100      
00704D42  5F00                    1101      subi.b  #7,d0
00704D44  6B12                    1102      bmi.s   .h2i_err            * quit if char is >'9' and <'A'
00704D46                          1103  
00704D46  0C00 000F               1104      cmpi.b  #15,d0
00704D4A  6E0C                    1105      bgt.s   .h2i_err            * quit if char is >'F'
00704D4C                          1106  
00704D4C                          1107  .h2i_2:
00704D4C  E98A                    1108      lsl.l   #4, d2
00704D4E  8400                    1109      or.b    d0, d2              * insert the new digit
00704D50                          1110  
00704D50  5301                    1111      subq.b  #1, d1              * decrement the digit count
00704D52  66D0                    1112      bne.s   .h2i_1              * go back for another digit?
00704D54                          1113  
00704D54                          1114  .h2i_x:
00704D54  2002                    1115      move.l  d2,d0               * put the answer back into D0
00704D56                          1116  *   move.l  (SP)+,d2            * restore D2
00704D56  4E75                    1117      rts
00704D58                          1118  
00704D58                          1119  .h2i_err:
00704D58                          1120  *   move.l  (SP)+,d2            * restore D2
00704D58  003C 0001               1121      ori.b   #1,CCR              * set the CARRY flag to signal an error
00704D5C  4E75                    1122      rts
00704D5E                          1123  
00704D5E                          1124  *--------------------------------------------------------------------------
00704D5E                          1125  * Read in an ASCII-HEX number with echo back
00704D5E                          1126  *
00704D5E                          1127  * D2 = Value to return if no digits read in
00704D5E                          1128  * D1 = Max no of ASCII digits to read in
00704D5E                          1129  * D0 = Result
00704D5E                          1130  * Carry flag set if an error occurs / not ASCII-HEX digit
00704D5E                          1131  *--------------------------------------------------------------------------
00704D5E                          1132  hexToIntEcho:
00704D5E                          1133  *   move.l  d2,-(SP)            * save D2
00704D5E                          1134  *   clr.l   d2                  * D2 used to accumulate the final value
00704D5E                          1135  .h2i_1:
00704D5E  6100 0106               1136      bsr.w   getc                * get a character
00704D62  6100 00F0               1137      bsr.w   putc                * echo it back
00704D66  6198                    1138      bsr.s   chToUpper           * convert to upper case if needed
00704D68                          1139  
00704D68  0C00 000A               1140      cmpi.b  #10,d0              * finish if it's CR or LF
00704D6C  6724                    1141      beq.s   .h2i_x
00704D6E  0C00 000D               1142      cmpi.b  #13,d0
00704D72  671E                    1143      beq.s   .h2i_x
00704D74                          1144      
00704D74  0400 0030               1145      subi.b  #'0',d0
00704D78  6B1C                    1146      bmi.s   .h2i_err            * quit if char is less than '0'
00704D7A                          1147  
00704D7A  0C00 0009               1148      cmpi.b  #9,d0
00704D7E  6F0A                    1149      ble.s   .h2i_2              * is it <= 9
00704D80                          1150      
00704D80  5F00                    1151      subi.b  #7,d0
00704D82  6B12                    1152      bmi.s   .h2i_err            * quit if char is >'9' and <'A'
00704D84                          1153  
00704D84  0C00 000F               1154      cmpi.b  #15,d0
00704D88  6E0C                    1155      bgt.s   .h2i_err            * quit if char is >'F'
00704D8A                          1156  
00704D8A                          1157  .h2i_2:
00704D8A  E98A                    1158      lsl.l   #4, d2
00704D8C  8400                    1159      or.b    d0, d2              * insert the new digit
00704D8E                          1160  
00704D8E  5301                    1161      subq.b  #1, d1              * decrement the digit count
00704D90  66CC                    1162      bne.s   .h2i_1              * go back for another digit?
00704D92                          1163  
00704D92                          1164  .h2i_x:
00704D92  2002                    1165      move.l  d2,d0               * put the answer back into D0
00704D94                          1166  *   move.l  (SP)+,d2            * restore D2
00704D94  4E75                    1167      rts
00704D96                          1168  
00704D96                          1169  .h2i_err:
00704D96                          1170  *   move.l  (SP)+,d2            * restore D2
00704D96  003C 0001               1171      ori.b   #1,CCR              * set the CARRY flag to signal an error
00704D9A  4E75                    1172      rts
00704D9C                          1173  
00704D9C                          1174  *******************************************************************************
00704D9C                          1175  *
00704D9C                          1176  *   #####  ####### ######  ###    #    #          ######  ####### ######  ####### 
00704D9C                          1177  *  #     # #       #     #  #    # #   #          #     # #     # #     #    #    
00704D9C                          1178  *  #       #       #     #  #   #   #  #          #     # #     # #     #    #    
00704D9C                          1179  *   #####  #####   ######   #  #     # #          ######  #     # ######     #    
00704D9C                          1180  *        # #       #   #    #  ####### #          #       #     # #   #      #    
00704D9C                          1181  *  #     # #       #    #   #  #     # #          #       #     # #    #     #    
00704D9C                          1182  *   #####  ####### #     # ### #     # #######    #       ####### #     #    #    
00704D9C                          1183  *                                                                                                   
00704D9C                          1184  *******************************************************************************
00704D9C                          1185  
00704D9C                          1186  *------------------------------------------------------------------------------
00704D9C                          1187  * Initialise the serial port
00704D9C                          1188  *
00704D9C                          1189  * Assumes that there is a 68681 DUART at the address defined by DUART1 in
00704D9C                          1190  * devices.inc and initialises port A and enables the rx interrupt.
00704D9C                          1191  *------------------------------------------------------------------------------
00704D9C                          1192  serInit:
00704D9C  13FC 0030 00D00005      1193      move.b  #$30, CRA           * Reset Transmitter
00704DA4  13FC 0020 00D00005      1194      move.b  #$20, CRA           * Reset Receiver
00704DAC  13FC 0010 00D00005      1195      move.b  #$10, CRA           * Reset Mode Register Pointer
00704DB4                          1196      
00704DB4  2D7C 00000000 0000      1197      move.l  #0,ser0RxHead(a6)   * Set queue head and tail ptrs to 0
00704DBC  3D7C 0000 0004          1198      move.w  #0,ser0RxSize(a6)   * No chars in receive queue
00704DC2                          1199  
00704DC2  13FC 0000 00D00009      1200      move.b  #$00, ACR           * Baud Rate Set #1
00704DCA  13FC 0013 00D00001      1201      move.b  #$13, MRA           * No Parity & 8-bit
00704DD2  13FC 0007 00D00001      1202      move.b  #$07, MRA           * Normal Mode, No CTS/RTS & 1 stop bit
00704DDA                          1203  
00704DDA                          1204      * if HI_SPEED = 0 then set 38400 baud
00704DDA                 FALSE    1205      ifeq HI_SPEED
00704DDA                          1206      endc
00704DDA                          1207  
00704DDA                          1208      * if HI_SPEED > 0 then set 115200 baud
00704DDA                 TRUE     1209      ifgt HI_SPEED
00704DDA  1039 00D00005           1210      move.b  CRA,d0              * Read CRA - sets BRG test mode
00704DE0  13FC 0066 00D00003      1211      move.b  #BAUD_1200, CSRA    * Set Tx and Rx baud rates to 115200 (old 1200)
00704DE8                          1212      endc
00704DE8                          1213      
00704DE8  13FC 0002 00D0000B      1214      move.b  #$02, IMR           * Rx interrupt enabled
00704DF0  13FC 0005 00D00005      1215      move.b  #$05, CRA           * Enable Transmit/Recieve
00704DF8  13FC 0001 00D0001D      1216      move.b  #$01, SOPR          * set OP0 low - i.e. CTS low
00704E00  4E75                    1217      rts
00704E02                          1218  
00704E02                          1219  *------------------------------------------------------------------------------
00704E02                          1220  * Serial port interrupt handler
00704E02                          1221  *
00704E02                          1222  * Should only be called when a char has been received.
00704E02                          1223  *
00704E02                          1224  *------------------------------------------------------------------------------
00704E02                          1225  serISR:
00704E02                          1226      * save registers we are about to trash
00704E02  48E7 E080               1227      movem.l d0-d2/a0,-(sp)
00704E06                          1228  
00704E06  0839 0001 00D0000B      1229      btst.b  #1,ISR              * check the RXRDYA bit
00704E0E  6700 003E               1230      beq.w   serExit
00704E12                          1231  
00704E12                          1232      * a char has been received so save it in the rx queue
00704E12  1039 00D00007           1233      move.b  RBA,d0              * get the character
00704E18  222E 0000               1234      move.l  ser0RxQueue(a6),d1  * D1.L MSW = head and LSW = tail
00704E1C  4841                    1235      swap    d1                  * D1.L MSW = tail and LSW = head
00704E1E  3401                    1236      move.w  d1,d2               * D2.W holds the queue head index
00704E20  4841                    1237      swap    d1                  * D1.L MSW = head and LSW = tail
00704E22                          1238  
00704E22                          1239  
00704E22  5242                    1240      addq.w  #1,d2               * advance the head index
00704E24  0242 00FF               1241      andi.w  #SERIAL_BUFFER_MASK,d2
00704E28  B441                    1242      cmp.w   d1,d2               * if head = tail then buffer full
00704E2A  6604                    1243      bne.s   serSave             * if head <> tail then add char to buffer
00704E2C                          1244  
00704E2C                          1245      * the serial buffer is full - what now?
00704E2C  6000 0020               1246      bra.w   serExit
00704E30                          1247  
00704E30                          1248  serSave:
00704E30  4841                    1249      swap    d1                  * D1.L MSW = tail and LSW = head
00704E32  1D80 1006               1250      move.b  d0,ser0RxBuf(a6,d1.w) * save the char to the rx queue
00704E36  3D42 0000               1251      move.w  d2,ser0RxHead(a6)   * save the updated head index
00704E3A  526E 0004               1252      addq.w  #1,ser0RxSize(a6)   * increment number of chars in rx queue
00704E3E                          1253  
00704E3E                          1254      * check if rx queue is nearly full
00704E3E  0C6E 00C8 0004          1255      cmpi.w  #SERIAL_BUFFER_UPPER,ser0RxSize(a6)
00704E44  6F08                    1256      ble.s   serExit
00704E46                          1257  
00704E46                          1258      * no of chars in queue has reached the upper threshold
00704E46                          1259      * set CTS HIGH to hopefully tell the host to stop sending.
00704E46  13FC 0001 00D0001F      1260      move.b  #$01, ROPR          * set OP0 high
00704E4E                          1261  
00704E4E                          1262  serExit:
00704E4E                          1263      * restore registers
00704E4E  4CDF 0107               1264      movem.l (sp)+,d0-d2/a0
00704E52  4E73                    1265      rte
00704E54                          1266  
00704E54                          1267  *------------------------------------------------------------------------------
00704E54                          1268  * Write a character directly to UART Port A, blocking if UART is not ready
00704E54                          1269  *
00704E54                          1270  * D0 = char to send
00704E54                          1271  *------------------------------------------------------------------------------
00704E54                          1272  putc:
00704E54  0839 0002 00D00003      1273      btst.b  #2, SRA             * Check if transmitter ready bit is set
00704E5C  67F6                    1274      beq     putc     
00704E5E  13C0 00D00007           1275      move.b  d0, TBA             * Transmit Character
00704E64  4E75                    1276      rts
00704E66                          1277  
00704E66                          1278  *------------------------------------------------------------------------------
00704E66                          1279  * Read a character from the rx queue - blocking call so will wait for character
00704E66                          1280  *
00704E66                          1281  * D0 = recevied char
00704E66                          1282  *------------------------------------------------------------------------------
00704E66                          1283  getc:
00704E66  0C6E 0000 0004          1284      cmpi.w  #0,ser0RxSize(a6)   * check number of chars in rx queue
00704E6C  67F8                    1285      beq.s   getc                * keep checking till there is a char available
00704E6E                          1286  
00704E6E                          1287      * save registers we are about to trash
00704E6E  48E7 4080               1288      movem.l d1/a0,-(sp)
00704E72                          1289      
00704E72                          1290      * get the character from the tail of the queue
00704E72  222E 0000               1291      move.l  ser0RxQueue(a6),d1  * D1.L MSW = head and LSW = tail
00704E76  1036 1006               1292      move.b  6(a6,d1.w),d0       * read the char from the queue tail
00704E7A  5241                    1293      addq.w  #1,d1               * advance the tail index
00704E7C  0241 00FF               1294      andi.w  #SERIAL_BUFFER_MASK,d1
00704E80  3D41 0002               1295      move.w  d1,ser0RxTail(a6)   * save the updated tail index
00704E84  536E 0004               1296      subq.w  #1,ser0RxSize(a6)   * decrement number of chars in rx queue
00704E88                          1297  
00704E88                          1298      * check if rx queue is nearly empty
00704E88  0C6E 0019 0004          1299      cmpi.w  #SERIAL_BUFFER_LOWER,ser0RxSize(a6)
00704E8E  6C08                    1300      bge.s   getExit
00704E90                          1301  
00704E90                          1302      * no of chars in queue has reached the lower threshold
00704E90                          1303      * set CTS LOW to hopefully tell the host to start sending.
00704E90  13FC 0001 00D0001D      1304      move.b  #$01, SOPR          * set OP0 low
00704E98                          1305  
00704E98                          1306  getExit:
00704E98                          1307      * restore registers
00704E98  4CDF 0102               1308      movem.l (sp)+,d1/a0
00704E9C  4E75                    1309      rts
00704E9E                          1310  
00704E9E                          1311  *******************************************************************************
00704E9E                          1312  *
00704E9E                          1313  *  #######    #     #####  #     #  #####   #####  #    #    ####### ######     #    ######   #####  
00704E9E                          1314  *  #         # #   #     #  #   #  #     # #     # #   #        #    #     #   # #   #     # #     # 
00704E9E                          1315  *  #        #   #  #         # #   #       #     # #  #         #    #     #  #   #  #     # #       
00704E9E                          1316  *  #####   #     #  #####     #    ######   #####  ###          #    ######  #     # ######   #####  
00704E9E                          1317  *  #       #######       #    #    #     # #     # #  #         #    #   #   ####### #             # 
00704E9E                          1318  *  #       #     # #     #    #    #     # #     # #   #        #    #    #  #     # #       #     # 
00704E9E                          1319  *  ####### #     #  #####     #     #####   #####  #    #       #    #     # #     # #        #####  
