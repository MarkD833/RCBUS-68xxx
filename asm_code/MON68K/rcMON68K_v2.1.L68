00704000                           265  *******************************************************************************
00704000                           266  * Below are the actual exception handlers that the RAM based vector table
00704000                           267  * initially points to. The user can overwrite the RAM vector table addresses
00704000                           268  * with the address of their own exception handler. These basic handlers simply
00704000                           269  * write a message to the serial port and enter an endless loop.
00704000                           270  *******************************************************************************
00704000                           271  
00704000                           272  *------------------------------------------------------------------------------
00704000                           273  * BUS ERROR handler
00704000                           274  * Print a message showing the PC and address being accessed
00704000                           275  *------------------------------------------------------------------------------
00704000                           276  handleBusErr:
00704000  41FA 0372                277      lea     bemsg1(PC), a0      * A0 = first message address
00704004  6100 0FF2                278      bsr.w   putString           * display it
00704008  202F 000A                279      move.l  10(a7),d0           * get the program counter 
0070400C  6100 0FA6                280      bsr.w   writeAddr32         * display it
00704010                           281      
00704010  41FA 03A1                282      lea     bemsg2(PC), a0      * A0 = second message address
00704014  6000 0132                283      bra.w   handleCleanUp
00704018                           284      
00704018                           285  *------------------------------------------------------------------------------
00704018                           286  * ADDRESS ERROR handler
00704018                           287  * Print a message showing the PC and address being accessed
00704018                           288  *------------------------------------------------------------------------------
00704018                           289  handleAddrErr:
00704018  41FA 0140                290      lea     aemsg1(PC), a0      * A0 = first message address
0070401C  6100 0FDA                291      bsr.w   putString           * display it
00704020  202F 000A                292      move.l  10(a7),d0           * get the program counter 
00704024  6100 0F8E                293      bsr.w   writeAddr32         * display it
00704028                           294      
00704028  41FA 0174                295      lea     aemsg2(PC), a0      * A0 = second message address
0070402C  6000 011A                296      bra.w   handleCleanUp
00704030                           297      
00704030                           298  *------------------------------------------------------------------------------
