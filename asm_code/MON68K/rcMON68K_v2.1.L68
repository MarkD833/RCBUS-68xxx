00704B16                           824  *------------------------------------------------------------------------------
00704B16                           825  * (M)odify memory
00704B16                           826  * Change memory contents 1 byte at a time
00704B16                           827  *------------------------------------------------------------------------------
00704B16                           828  cmdModifyMemory:
00704B16  6100 033C                829      bsr.w   putc                * echo back the command character in D0
00704B1A  103C 0020                830      move.b  #' ',d0
00704B1E  6100 0334                831      bsr.w   putc
00704B22                           832  
00704B22  4282                     833      clr.l   d2                  * pre-set D2 to 0
00704B24  7208                     834      move.l  #8,d1               * read up to 8 digits
00704B26  6100 0236                835      bsr.w   hexToIntEcho        * from the serial port
00704B2A  6500 FE80                836      bcs.w   monLoop             * back to prompt if there's an error
00704B2E  1200                     837      move.b  d0,d1               * save the typed in address
00704B30  6100 04C2                838      bsr.w   putCRLF
00704B34  1001                     839      move.b  d1,d0               * restore the typed in address
00704B36                           840      
00704B36  2040                     841      move.l  d0,a0               * copy address into A0
00704B38                           842  .cMM_1:
00704B38  6100 047A                843      bsr.w   writeAddr32         * display the memory location address
00704B3C  103C 0020                844      move.b  #' ',d0
00704B40  6100 0312                845      bsr.w   putc
00704B44  1010                     846      move.b  (a0),d0             * get the current memory contents
00704B46  1400                     847      move.b  d0,d2               * pre-set D2 to the existing memory value
00704B48  6100 0488                848      bsr.w   writeByte           * display the byte
00704B4C  103C 0020                849      move.b  #' ',d0
00704B50  6100 0302                850      bsr.w   putc
00704B54  7202                     851      move.l  #2,d1               * read up to 2 digits
00704B56  6100 0206                852      bsr.w   hexToIntEcho        * from the serial port
00704B5A  6500 0010                853      bcs.w   .cMM_2              * back to prompt if there's an error
00704B5E                           854  
00704B5E  10C0                     855      move.b  d0,(a0)+            * write out the new byte and move on
00704B60  2F08                     856      move.l  a0,-(SP)            * save our address
00704B62  6100 0490                857      bsr.w   putCRLF
00704B66  205F                     858      move.l  (SP)+,a0            * restore our address
00704B68  2008                     859      move.l  a0,d0               * copy address back into D0 for printing
00704B6A  60CC                     860      bra.s   .cMM_1
00704B6C                           861  
00704B6C                           862  .cMM_2:
00704B6C  6100 0486                863      bsr.w   putCRLF
00704B70  6000 FE3A                864      bra.w   monLoop
